#!/usr/bin/env bash
# Write an application image to the Picco app slot over USB and boot it.
# Touches only the application partition at 0xE0000; see docs/picco-firmware.md.
set -euo pipefail
cd "$(dirname "$0")/.."
if ! command -v esptool >/dev/null; then
  exec nix-shell -p esptool --run "$(printf '%q ' "$0" "$@")"
fi
image="${1:-output/picco/femto-picco.bin}"
port="${FEMTO_PICCO_PORT:-$(ls /dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_*-if00 | head -n 1)}"
common=(--chip esp32s3 --port "$port")
esptool "${common[@]}" --baud 921600 --before default-reset --after no-reset \
  write-flash --flash-mode keep --flash-freq keep --flash-size keep 0xe0000 "$image"
# An ordinary hard reset leaves this board in ROM download mode.
esptool "${common[@]}" --before no-reset --after watchdog-reset flash-id
