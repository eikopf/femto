#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if ! command -v cargo >/dev/null || ! command -v python >/dev/null; then
  exec nix-shell shell.nix --run './scripts/probe-control'
fi
cargo build --locked -p femto-microlink --example control-probe --target-dir target
timeout 45s python scripts/probe-control.py
