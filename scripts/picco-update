#!/usr/bin/env bash
# Update a Picco that already runs femto: copy the image to the card over USB,
# let the stock recovery application install it, and restart into it.
# The first installation uses scripts/picco-flash; see docs/picco-firmware.md.
set -euo pipefail
cd "$(dirname "$0")/.."
if ! command -v esptool >/dev/null || ! command -v python >/dev/null; then
  exec nix-shell -p esptool python3 --run "$(printf '%q ' "$0" "$@")"
fi
image="${1:-output/picco-grayscale/femto-picco.bin}"
port="${FEMTO_PICCO_PORT:-$(ls /dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_*-if00 | head -n 1)}"
python scripts/picco-console.py --port "$port" --timeout 300 update "$image"
# Recovery waits for a tap on Restart; a reset does the same from here.
esptool --chip esp32s3 --port "$port" --before default-reset --after watchdog-reset flash-id >/dev/null
echo "Installed $image"
