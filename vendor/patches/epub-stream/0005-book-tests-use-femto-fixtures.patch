     #[test]
+    fn original_book_fixtures_load_navigation_and_exact_cover_bytes() {
+        let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../tests/fixtures");
+        let expected = std::fs::read(root.join("gradient.jpg")).unwrap();
+        assert!(expected.len() > 1024);
+        for name in ["book-api.epub", "book-api-legacy-cover.epub"] {
+            let file = std::fs::File::open(root.join(name)).unwrap();
+            let mut book = EpubBook::from_reader(file).unwrap();
+            assert_eq!(book.chapter_count(), 1);
+            assert!(book.ensure_navigation().unwrap().is_some());
+            let mut bytes = b"stale bytes".to_vec();
+            let cover = book.read_cover_image_into(&mut bytes).unwrap().unwrap();
+            assert_eq!(cover.source, CoverImageSource::Manifest);
+            assert_eq!(bytes, expected);
+        }
+    }
