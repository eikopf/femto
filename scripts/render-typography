#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if ! command -v cargo >/dev/null; then
  exec nix-shell shell.nix --run './scripts/render-typography'
fi
cargo build --locked -p femto
for levels in 2 4; do
  for size in 18 24 30; do
    for profile in neutral weight coverage fractional unhinted; do
      options=()
      case "$profile" in
        weight) options=(--text-stroke 0.2);;
        coverage) options=(--text-gamma 0.7);;
        fractional) options=(--fractional-text true);;
        unhinted) options=(--text-hinting false);;
      esac
      target/debug/femto render tests/fixtures/typography.txt \
        --font tests/fixtures/DejaVuSerif.ttf \
        --fallback-font tests/fixtures/DejaVuSans.ttf \
        --font-size "$size" --levels "$levels" "${options[@]}" \
        --output "output/typography/${levels}-levels/${size}px/$profile"
    done
  done
done
