+    fn navigation_note_semantics_are_order_independent_and_bounded() {
+        fn events(attributes: &str) -> Result<Vec<StyledEventOrRun>, RenderPrepError> {
+            let xml = format!("<a xmlns:epub='http://www.idpf.org/2007/ops' {attributes}/>");
+            let mut reader = NsReader::from_str(&xml);
+            let mut events = Vec::new();
+            if let Event::Empty(element) = reader.read_event().unwrap() {
+                emit_navigation(&reader, &element, &mut |event| events.push(event))?;
+            } else { panic!("expected empty anchor"); }
+            Ok(events)
+        }
+        for attributes in [
+            "href='#note' epub:type='other noteref'",
+            "epub:type='noteref' href='#note'",
+            "role='doc-noteref' href='#note'",
+            "href='#note' role='doc-noteref'",
+            "xmlns:n='http://www.idpf.org/2007/ops' n:type='noteref' href='#note'",
+        ] {
+            assert!(matches!(&events(attributes).unwrap()[..], [StyledEventOrRun::NoteReferenceStart(href)] if href == "#note"));
+        }
+        assert!(events("role='doc-noteref'").unwrap().is_empty());
+        for key in ["role", "epub:type"] {
+            assert!(events(&format!("href='#note' {key}='{}'", "x".repeat(4097))).is_err());
+        }
+    }
