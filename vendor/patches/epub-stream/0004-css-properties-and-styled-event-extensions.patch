+fn emit_navigation<F: FnMut(StyledEventOrRun)>(
+    reader: &NsReader<&[u8]>,
+    element: &quick_xml::events::BytesStart<'_>,
+    on_item: &mut F,
+) -> Result<(), RenderPrepError> {
+    let tag = decode_tag_name(reader, element.name().as_ref())?;
+    let mut href = None;
+    let mut noteref = false;
+    for attribute in element.attributes().flatten() {
+        let key = attribute.key.as_ref();
+        let (namespace, local) = reader.resolver().resolve_attribute(attribute.key);
+        let epub_type = local.as_ref() == b"type"
+            && matches!(namespace, ResolveResult::Bound(uri) if uri.as_ref() == b"http://www.idpf.org/2007/ops");
+        if tag == "a" && (epub_type || key == b"role") {
+            let value = attribute.decode_and_unescape_value(reader.decoder())
+                .map_err(|error| RenderPrepError::new("NAV_ATTRIBUTE", error.to_string()))?;
+            if value.len() > 4096 {
+                return Err(RenderPrepError::new("NAV_ATTRIBUTE_LIMIT", "Navigation attribute exceeds 4096 bytes"));
+            }
+            noteref |= value.split_ascii_whitespace().any(|token|
+                (epub_type && token == "noteref") || (key == b"role" && token == "doc-noteref"));
+            continue;
+        }
+        if (tag == "ol" || tag == "li") && key == b"type" {
+            let value = attribute.decode_and_unescape_value(reader.decoder())
+                .map_err(|error| RenderPrepError::new("LIST_ATTRIBUTE", error.to_string()))?;
+            if value.len() > 4096 { return Err(RenderPrepError::new("LIST_ATTRIBUTE_LIMIT", "List attribute exceeds 4096 bytes")); }
+            let style = match value.as_ref() {
+                "1" => Some(ListNumberStyle::Decimal),
+                "a" => Some(ListNumberStyle::LowerAlpha),
+                "A" => Some(ListNumberStyle::UpperAlpha),
+                "i" => Some(ListNumberStyle::LowerRoman),
+                "I" => Some(ListNumberStyle::UpperRoman),
+                _ => None,
+            };
+            if let Some(style) = style {
+                on_item(StyledEventOrRun::Event(if tag == "ol" { StyledEvent::ListNumberStyle(style) } else { StyledEvent::ListItemNumberStyle(style) }));
+            }
+            continue;
+        }
+        if (tag == "ol" && key == b"start") || (tag == "li" && key == b"value") {
+            let value = attribute.decode_and_unescape_value(reader.decoder())
+                .map_err(|error| RenderPrepError::new("LIST_ATTRIBUTE", error.to_string()))?;
+            if value.len() > 4096 { return Err(RenderPrepError::new("LIST_ATTRIBUTE_LIMIT", "List attribute exceeds 4096 bytes")); }
+            if let Ok(number) = value.trim_matches(|c: char| c.is_ascii_whitespace()).parse::<i32>() {
+                on_item(StyledEventOrRun::Event(if tag == "ol" { StyledEvent::ListStartAt(number) } else { StyledEvent::ListItemValue(number) }));
+            }
+            continue;
+        }
+        if key != b"id" && key != b"xml:id" && !(tag == "a" && (key == b"name" || key == b"href")) {
+            continue;
+        }
+        let value = attribute
+            .decode_and_unescape_value(reader.decoder())
+            .map_err(|error| RenderPrepError::new("NAV_ATTRIBUTE", error.to_string()))?
+            .into_owned();
+        if value.len() > 4096 {
+            return Err(RenderPrepError::new(
+                "NAV_ATTRIBUTE_LIMIT",
+                "Navigation attribute exceeds 4096 bytes",
+            ));
+        }
+        if key == b"href" {
+            href = Some(value);
+        } else if !value.is_empty() {
+            on_item(StyledEventOrRun::Anchor(value));
+        }
+    }
+    if let Some(href) = href {
+        on_item(if noteref { StyledEventOrRun::NoteReferenceStart(href) }
+            else { StyledEventOrRun::LinkStart(href) });
+    }
+    Ok(())
+}
