+fn is_note_body(reader: &NsReader<&[u8]>, element: &quick_xml::events::BytesStart<'_>) -> Result<bool, RenderPrepError> {
+    let mut marked = false;
+    for attr in element.attributes() {
+        let attr = attr.map_err(|e| RenderPrepError::new("NOTE_ATTRIBUTE", e.to_string()))?;
+        let (namespace, local) = reader.resolver().resolve_attribute(attr.key);
+        let epub_type = local.as_ref() == b"type"
+            && matches!(namespace, ResolveResult::Bound(uri) if uri.as_ref() == b"http://www.idpf.org/2007/ops");
+        let role = attr.key.as_ref() == b"role";
+        if !epub_type && !role { continue; }
+        let value = attr.decode_and_unescape_value(reader.decoder()).map_err(|e| RenderPrepError::new("NOTE_ATTRIBUTE", e.to_string()))?;
+        if value.len() > 4096 { return Err(RenderPrepError::new("NOTE_ATTRIBUTE_LIMIT", "Note attribute exceeds 4096 bytes")); }
+        marked |= value.split_ascii_whitespace().any(|token|
+            (epub_type && matches!(token, "footnote" | "endnote"))
+            || (role && matches!(token, "doc-footnote" | "doc-endnote")));
+    }
+    Ok(marked)
+}
