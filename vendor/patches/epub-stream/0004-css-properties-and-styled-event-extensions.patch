+fn reversed_list_counts(html: &[u8]) -> Result<BTreeMap<u64, u32>, RenderPrepError> {
+    let mut counts = BTreeMap::new();
+    if !html.windows(8).any(|bytes| bytes == b"reversed") { return Ok(counts); }
+    let mut reader = Reader::from_reader(html);
+    let mut depth = 0usize;
+    let mut skipped = None;
+    let mut lists: Vec<(usize, u64, u32)> = Vec::new();
+    loop {
+        let event = reader.read_event().map_err(|e| RenderPrepError::new("LIST_XML", e.to_string()))?;
+        match event {
+            Event::Start(ref element) | Event::Empty(ref element) => {
+                let empty = matches!(event, Event::Empty(_));
+                let tag = decode_tag_name(&reader, element.name().as_ref())?;
+                if skipped.is_none() && should_skip_tag(&tag) && !empty { skipped = Some(depth); }
+                if skipped.is_none() {
+                    if tag == "li" {
+                        if let Some((parent, _, count)) = lists.last_mut() {
+                            if depth == *parent + 1 {
+                                if *count >= 16_384 { return Err(RenderPrepError::new("LIST_COUNT_LIMIT", "List item count limit exceeded")); }
+                                *count += 1;
+                            }
+                        }
+                    }
+                    if tag == "ol" && element.attributes().flatten().any(|attr| attr.key.as_ref() == b"reversed") {
+                        if lists.len() >= 16 || counts.len() >= 1024 { return Err(RenderPrepError::new("LIST_COUNT_LIMIT", "Reversed list limit exceeded")); }
+                        if empty { counts.insert(reader.buffer_position(), 0); }
+                        else { lists.push((depth, reader.buffer_position(), 0)); }
+                    }
+                }
+                if !empty { depth += 1; }
+            }
+            Event::End(_) => {
+                depth = depth.saturating_sub(1);
+                if skipped == Some(depth) { skipped = None; }
+                if lists.last().is_some_and(|(start, _, _)| *start == depth) {
+                    let (_, offset, count) = lists.pop().unwrap();
+                    if counts.len() >= 1024 { return Err(RenderPrepError::new("LIST_COUNT_LIMIT", "Reversed list limit exceeded")); }
+                    counts.insert(offset, count);
+                }
+            }
+            Event::Eof => {
+                if !lists.is_empty() { return Err(RenderPrepError::new("LIST_XML", "Unclosed reversed list")); }
+                break;
+            }
+            _ => {}
+        }
+    }
+    Ok(counts)
+}
