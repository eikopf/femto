CONFIG_IDF_TARGET="esp32s3"
CONFIG_APP_REPRODUCIBLE_BUILD=y
# The version identifies femto images to the updater; see src/update.rs.
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="femto-0.1.7"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Internal RAM is scarce: general allocations, Wi-Fi/lwIP buffers and TLS
# use external RAM, leaving internal memory to stacks and drivers that need it.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Framebuffers live in PSRAM; the packed plane should fit in the data cache.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=98304
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# A TLS handshake is the reader's own arithmetic, and a tailnet join makes
# two before its first packet. Optimising the C code for speed, precomputed
# multiples of the curve base points, and software arithmetic in place of
# the hardware multiplier (measured slower at elliptic-curve sizes) took a
# handshake from 2.7 to 1.6 seconds for 90 KiB more image; see
# docs/device-network.md.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_MBEDTLS_HARDWARE_MPI=n
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_ESP_TLS_INSECURE=n
CONFIG_LWIP_SNTP_MAX_SERVERS=1
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000
# The first query goes out at once. The optional random delay spreads the
# queries of many devices that power on together, which a reader does not do.
CONFIG_LWIP_SNTP_STARTUP_DELAY=n

CONFIG_MBEDTLS_THREADING_C=y
CONFIG_MBEDTLS_THREADING_ALT=n
CONFIG_MBEDTLS_THREADING_PTHREAD=y

# A sleep shorter than one tick spins instead of yielding, which starves
# every lower-priority task; network code sleeps for 1 ms between polls.
CONFIG_FREERTOS_HZ=1000

# Catalog feeds run to 100 KB; the default 5.7 KB window costs a radio
# round trip for every few packets.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

# Calibrate the radio at every start. With stored calibration data ESP-IDF
# skips calibration after a wake from deep sleep, and the access point then
# left the reader's first association request unanswered in every wake
# measured, which cost a scan and about seven seconds.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
