+    /// Prepare an OPF-relative XHTML resource, including documents outside the spine.
+    pub fn prepare_resource_with<R: std::io::Read + std::io::Seek, F: FnMut(StyledEventOrRun)>(
+        &mut self,
+        book: &mut EpubBook<R>,
+        href: &str,
+        mut on_item: F,
+    ) -> Result<(), RenderPrepError> {
+        let mut html = Vec::new();
+        book.read_resource_into_with_hard_cap(href, &mut html, self.opts.memory.max_entry_bytes)
+            .map_err(|e| {
+                RenderPrepError::new_with_phase(
+                    ErrorPhase::Parse,
+                    "BOOK_RESOURCE_READ",
+                    e.to_string(),
+                )
+                .with_path(href.to_string())
+            })?;
+        self.apply_chapter_stylesheets_with_budget(book, usize::MAX, href, &html)?;
+        let image_dimensions = self.collect_intrinsic_image_dimensions(book, href, &html);
+        let font_resolver = &self.font_resolver;
+        self.styler.style_chapter_bytes_with(&html, |item| {
+            let item = resolve_item_assets_for_chapter(href, Some(&image_dimensions), item);
+            let (item, _) = resolve_item_with_font(font_resolver, item);
+            on_item(item);
+        })
+    }
+
