#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if ! command -v cargo >/dev/null; then
  exec nix-shell shell.nix --run './scripts/check'
fi
cargo fmt --all --check
python -m unittest discover -s tests/firmware -v
cargo check --workspace --features femto-catalog/tailnet --locked
cargo clippy --workspace --all-targets --features desktop,femto-catalog/tailnet --locked -- -D warnings
cargo test --workspace --features desktop,femto-catalog/tailnet --locked
cargo test --locked -p epub-stream --lib
cargo test --locked -p miniz_oxide@0.9.1

cargo test --locked --manifest-path vendor/quireink-stardict/Cargo.toml --config 'patch.crates-io.miniz_oxide.path="vendor/miniz_oxide"'
cargo test --locked --manifest-path vendor/hidreport/Cargo.toml --lib
